# Copy to .env and fill in. .env is git-ignored: real keys go there, never here.
# maia-be runs on localhost:3000, maia-fe on localhost:3001

DATABASE_URL="postgresql://maia:maia@localhost:5433/maia?schema=public"

# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me"

# Public address of the app (maia-fe). Email links point here; with https://
# the session cookies are marked Secure automatically.
APP_URL="http://localhost:3001"

# Resend API key (re_...). Empty = emails go to Mailpit (http://localhost:8025),
# nothing is really sent.
RESEND_API_KEY=""

# Sender. With Resend it must use a domain verified in Resend; before that only
# "MAIA <onboarding@resend.dev>" works, and only towards your own Resend address.
MAIL_FROM="MAIA <noreply@your-domain.it>"

# Optional: also notified when a new account waits for approval (besides ADMIN accounts).
ADMIN_EMAIL=""
