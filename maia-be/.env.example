# Copy to .env and fill in. .env is git-ignored: real keys go there, never here.
# maia-be runs on localhost:3000, maia-fe on localhost:3001
DATABASE_URL="postgresql://maia:maia@localhost:5433/maia?schema=public"
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me"
# Links in the emails point here (the app, not the API).
APP_URL="http://localhost:3001"

# --- Email ---------------------------------------------------------------------
# Resend over SMTP (https://resend.com): SMTP_PASS is your Resend API key (re_...).
# MAIL_FROM must use a domain verified in Resend. Without a verified domain, Resend
# only allows MAIL_FROM="MAIA <onboarding@resend.dev>" and only to your own address.
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="resend"
SMTP_PASS="re_your_resend_api_key"
MAIL_FROM="MAIA <noreply@your-domain.it>"

# Local testing without sending real emails: use Mailpit from docker-compose instead
# (every email shows up on http://localhost:8025). Replace the block above with:
# SMTP_HOST="localhost"
# SMTP_PORT="1025"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# MAIL_FROM="MAIA <noreply@maia.local>"

# Also notified when a new account waits for approval (besides ADMIN accounts).
ADMIN_EMAIL=""
# "true" in production (HTTPS).
COOKIE_SECURE="false"
